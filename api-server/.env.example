SUPABASE_URL=
SUPABASE_ANON_KEY=

ANTHROPIC_API_KEY=
MESHY_API_KEY=
MESHY_SKIP_REFINE=
PORT=
NODE_ENV=

# Cloudflare R2 — account shared by both environments
R2_ACCOUNT_ID=

# Public access URLs (enable public access on each bucket in R2 dashboard to get these)
R2_PROD_PUBLIC_URL=
R2_DEV_PUBLIC_URL=

# R2 — development (bucket: pludo-assets-dev)
R2_DEV_ACCESS_KEY_ID=
R2_DEV_SECRET_ACCESS_KEY=
R2_DEV_BUCKET=

# R2 — production (bucket: pludo-assets)
R2_PROD_ACCESS_KEY_ID=
R2_PROD_SECRET_ACCESS_KEY=
R2_PROD_BUCKET=

# Service role — used by api-server for tables that ANON has no access to (asset_cache, asset_cache_hits)
SUPABASE_SERVICE_ROLE_KEY=
